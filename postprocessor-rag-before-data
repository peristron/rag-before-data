res = load_resources(st.session_state.active_path)

if not res:
    st.error(f"⚠️ Artifacts not found in `{st.session_state.active_path}`.")
    st.stop()

metadata, collection = res

# 3. CHAT INTERFACE
for msg in st.session_state.messages: st.chat_message(msg["role"]).write(msg["content"])

if prompt := st.chat_input():
    st.session_state.messages.append({"role": "user", "content": prompt})
    st.chat_message("user").write(prompt)
    
    with st.chat_message("assistant"):
        with st.status("Thinking...", expanded=False) as status:
            try:
                status.write("🔍 Identifying relevant columns...")
                results = collection.query(query_texts=[prompt], n_results=5)
                context = "\n".join(results['documents'][0])
                
                status.write("📝 Writing SQL query (gpt-4o-mini)...")
                sql = get_sql_query(prompt, context, metadata, client, st.session_state.active_path)
                st.code(sql, language="sql")
                
                status.write("⚡ Executing (Cached)...")
                df = execute_sql(sql)
                st.dataframe(df)
                
                attempt_visualization(df)
                
                if not df.empty: answer = summarize_answer(prompt, df, client)
                else: answer = "No results found."
                
                status.update(label="✅ Answer Ready", state="complete")
                st.write(answer)
                st.session_state.messages.append({"role": "assistant", "content": answer})
                
            except Exception as e:
                st.error(f"Error: {str(e)}")
                status.update(label="❌ Failed", state="error")
