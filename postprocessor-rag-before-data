@st.cache_resource(show_spinner="Loading resources...")
def load_resources(path):
    if not os.path.exists(path): return None, None, None
    data_exists = False
    try:
        for f in os.listdir(path):
            if f.endswith(".parquet"):
                data_exists = True; break
    except: return None, None, None
    if not data_exists: return None, None, None

    try:
        with open(os.path.join(path, "metadata.json"), "r") as f: metadata = json.load(f)
        chroma_client = chromadb.PersistentClient(path=os.path.join(path, "chroma_db"))
        collection = chroma_client.get_collection("dataset_schema")
        return metadata, collection
    except: return None, None, None

def get_sql_query(question, context, metadata, client, artifacts_path):
    today = datetime.date.today().strftime("%Y-%m-%d")
    
    table_list = []
    if 'tables' in metadata:
        for t_name, t_info in metadata['tables'].items():
            f_pattern = os.path.join(artifacts_path, t_info['file_pattern']).replace("\\", "/")
            table_list.append(f"- Table: '{t_name}' -> File: '{f_pattern}'")
    else:
        f_pattern = os.path.join(artifacts_path, "data_*.parquet").replace("\\", "/")
        table_list.append(f"- Table: 'data' -> File: '{f_pattern}'")

    table_inventory = "\n".join(table_list)
    
    prompt = f"""
    You are an expert DuckDB SQL Analyst.
    Current Date: {today}
    
    AVAILABLE TABLES:
    {table_inventory}
    
    RELEVANT COLUMNS FOUND:
    {context}
    
    USER QUESTION: 
    "{question}"
    
    STRICT RULES:
    1. Output ONLY valid SQL. No markdown.
    2. SYNTAX: Use `read_parquet('path/to/pattern')` for FROM clauses.
    3. JOINS: If multiple tables exist, join them on common keys.
    4. DATE LOGIC: Check context for best date column.
    5. AGGREGATION: Enforce GROUP BY when mixing aggregates.
    6. LIMIT: Default to 50 unless specified.
    7. SCHEMA: If asked for "columns", use `DESCRIBE SELECT * FROM ...`
    8. FUZZY SEARCH: Use `ILIKE '%term%'`.
    9. SAFE DIVISION: Use `CASE WHEN Denom = 0 THEN 0 ELSE Num/Denom END`.
    10. NULLS: Exclude NULLs.
    11. ORDERING: Top/Best = `DESC`.
    12. DISTINCT: `COUNT(DISTINCT col)`.
    13. DATE GROUPING: Use `date_trunc`.
    14. CASTING: Cast integers to `DOUBLE` for division.
    """
    
    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=[{"role": "system", "content": "You are a SQL generator."},
                  {"role": "user", "content": prompt}],
        temperature=0
    )
    return response.choices[0].message.content.strip().replace("```sql", "").replace("```", "")

@st.cache_data(show_spinner=False)
def execute_sql(sql_query):
    conn = duckdb.connect(database=':memory:', read_only=False)
    try:
        df = conn.execute(sql_query).df()
        return df
    except Exception as e:
        raise e
    finally:
        conn.close()

def summarize_answer(question, df, client):
    data_str = df.to_string(index=False)
    prompt = f"""
    User Question: {question}
    SQL Result Data:
    {data_str}
    
    Task: Summarize this answer in plain English. 
    """
    response = client.chat.completions.create(
        model="gpt-4o-mini",
        messages=[{"role": "user", "content": prompt}]
    )
    return response.choices[0].message.content

def attempt_visualization(df):
    try:
        if df.empty or len(df.columns) < 2: return
        num_cols = df.select_dtypes(include=['number']).columns.tolist()
        date_cols = df.select_dtypes(include=['datetime', 'datetimetz']).columns.tolist()
        cat_cols = df.select_dtypes(include=['object', 'string', 'category']).columns.tolist()

        if not date_cols and cat_cols:
            for c in cat_cols:
                try:
                    converted = pd.to_datetime(df[c], errors='coerce')
                    if converted.notna().mean() > 0.8:
                        df[c] = converted
                        date_cols.append(c)
                        cat_cols.remove(c)
                except: pass

        st.caption("📊 Auto-Visualization")
        
        if date_cols and num_cols:
            st.line_chart(df.set_index(date_cols[0])[num_cols[0]])
            return

        if cat_cols and num_cols:
            if len(df) > 20: df = df.head(20)
            st.bar_chart(df.set_index(cat_cols[0])[num_cols[0]])
            return

    except Exception: pass

